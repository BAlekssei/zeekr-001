{
 "uid": "zeekr-battery-health",
 "title": "Zeekr — Состояние батареи",
 "tags": [
  "zeekr"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "1m",
 "time": {
  "from": "now-1y",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "type": "textbox",
    "name": "battery_capacity",
    "label": "Ёмкость батареи, кВт·ч",
    "query": "100",
    "current": {
     "selected": false,
     "text": "100",
     "value": "100"
    },
    "options": [
     {
      "selected": true,
      "text": "100",
      "value": "100"
     }
    ],
    "hide": 0
   },
   {
    "type": "textbox",
    "name": "ac_price",
    "label": "Тариф AC, ₽/кВт·ч",
    "query": "6.5",
    "current": {
     "selected": false,
     "text": "6.5",
     "value": "6.5"
    },
    "options": [
     {
      "selected": true,
      "text": "6.5",
      "value": "6.5"
     }
    ],
    "hide": 0
   },
   {
    "type": "textbox",
    "name": "ac_eff",
    "label": "КПД AC-зарядки (оценка)",
    "query": "0.9",
    "current": {
     "selected": false,
     "text": "0.9",
     "value": "0.9"
    },
    "options": [
     {
      "selected": true,
      "text": "0.9",
      "value": "0.9"
     }
    ],
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Оценка ёмкости батареи по зарядкам AC",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 16,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "(last_over_time(zeekr_charge_energy_used_kwh[1h]) * $ac_eff / ((last_over_time(zeekr_charge_soc_end[1h]) - last_over_time(zeekr_charge_soc_start[1h])) / 100)) and on(id) ((last_over_time(zeekr_charge_soc_end[1h]) - last_over_time(zeekr_charge_soc_start[1h])) >= 10) and on(id) (last_over_time(zeekr_charge_dc[1h]) == 0)",
     "legendFormat": "кВт·ч (по зарядке)",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     }
    },
    {
     "expr": "vector($battery_capacity)",
     "legendFormat": "номинал",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "spanNulls": 600000,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "Ёмкость = энергия из сети × КПД / прирост SOC; считается для AC-зарядок с приростом ≥ 10 %. Оценка зашумлена.",
   "id": 1
  },
  {
   "type": "stat",
   "title": "Оценочная деградация",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "(1 - quantile(0.5, (last_over_time(zeekr_charge_energy_used_kwh[$__range]) * $ac_eff / ((last_over_time(zeekr_charge_soc_end[$__range]) - last_over_time(zeekr_charge_soc_start[$__range])) / 100)) and on(id) ((last_over_time(zeekr_charge_soc_end[$__range]) - last_over_time(zeekr_charge_soc_start[$__range])) >= 10) and on(id) (last_over_time(zeekr_charge_dc[$__range]) == 0)) / $battery_capacity) * 100",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "description": "Медиана оценок ёмкости за период относительно номинала (переменная battery_capacity).",
   "id": 2
  },
  {
   "type": "stat",
   "title": "Полных циклов",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "sum(last_over_time(zeekr_charge_energy_added_kwh[$__range])) / $battery_capacity",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "id": 3
  },
