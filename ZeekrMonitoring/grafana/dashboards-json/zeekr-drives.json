     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "expr": "((last_over_time(zeekr_drive_soc_start[$__range]) - last_over_time(zeekr_drive_soc_end[$__range])) / 100 * $battery_capacity * 1000 / (last_over_time(zeekr_drive_distance_km[$__range]))) and on(id) (last_over_time(zeekr_drive_distance_km[$__range]) >= $min_dist)",
     "legendFormat": "",
     "refId": "J",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "instant": true,
     "range": false,
     "format": "table"
