    {
     "expr": "sum(last_over_time(zeekr_charge_energy_added_kwh[$__range]) * last_over_time(zeekr_charge_dc[$__range]))",
     "legendFormat": "DC",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "id": 2
  },
