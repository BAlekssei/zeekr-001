    "x": 6,
    "y": 0,
    "w": 10,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "sum(last_over_time(zeekr_charge_energy_added_kwh[$__range]) * (1 - last_over_time(zeekr_charge_dc[$__range])))",
     "legendFormat": "AC",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "instant": true,
     "range": false
