   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "sum(last_over_time(zeekr_charge_energy_added_kwh[$__range]))",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "id": 1
  },
  {
