   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "last_over_time(zeekr_prop{name=\"ID_CHARGING_WORK_CURRENT\",area=\"1\"}[1h])",
