  {
   "type": "timeseries",
   "title": "Ход зарядки",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "zeekr_soc_percent",
     "legendFormat": "SOC, %",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     }
    },
    {
     "expr": "(zeekr_prop{name=\"ID_CHARGING_WORK_VOLTAGE\",area=\"1\"} * ignoring(name) zeekr_prop{name=\"ID_CHARGING_WORK_CURRENT\",area=\"1\"} / 1000)",
     "legendFormat": "мощность, кВт",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     }
    },
    {
     "expr": "zeekr_range_km",
     "legendFormat": "запас хода, км",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     }
    },
    {
     "expr": "zeekr_prop{name=\"ID_CHARGING_WORK_VOLTAGE\",area=\"1\"}",
