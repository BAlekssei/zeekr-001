    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "id": 8
  },
  {
   "type": "stat",
   "title": "Мощность",
   "gridPos": {
    "x": 12,
    "y": 3,
    "w": 4,
    "h": 3
