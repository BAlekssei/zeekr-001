   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "time() - last_over_time(timestamp(zeekr_prop{name=\"ID_CHARGING_PLUG_STATE_AC\"} == 0)[7d])",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "description": "Время с последнего момента, когда разъём AC был не подключён (по метрике состояния разъёма).",
   "id": 5
  },
  {
   "type": "stat",
   "title": "Лимит зарядки",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "last_over_time(zeekr_prop{name=\"ID_CHARGING_SOC_LEVEL\"}[1h])",
