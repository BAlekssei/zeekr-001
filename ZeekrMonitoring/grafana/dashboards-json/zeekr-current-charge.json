{
 "uid": "zeekr-current-charge",
 "title": "Zeekr — Текущая зарядка",
 "tags": [
  "zeekr"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "10s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "type": "gauge",
   "title": "Уровень заряда",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 5,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "last_over_time(zeekr_soc_percent[1h])",
     "legendFormat": "SOC",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 20
       },
       {
        "color": "green",
        "value": 40
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdMarkers": true
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Добавлено за период",
   "gridPos": {
    "x": 5,
    "y": 0,
    "w": 4,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "last_over_time(zeekr_soc_percent[$__range]) - first_over_time(zeekr_soc_percent[$__range])",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "description": "Разница SOC между началом и концом выбранного периода: выберите период, равный сессии зарядки.",
   "id": 2
  },
  {
   "type": "stat",
   "title": "Начальный SOC",
   "gridPos": {
    "x": 9,
    "y": 0,
    "w": 3,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "first_over_time(zeekr_soc_percent[$__range])",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "Запас хода",
