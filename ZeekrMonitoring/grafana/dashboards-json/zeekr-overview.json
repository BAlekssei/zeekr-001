   "title": "Состояния",
   "gridPos": {
    "x": 12,
    "y": 17,
    "w": 12,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "vm"
   },
   "targets": [
    {
     "expr": "((sum(last_over_time(zeekr_speed[2m]) >= bool 1) default 0) + 2 * (sum(last_over_time(zeekr_prop{name=\"ID_CHARGING_WORK_CURRENT\",area=\"1\"}[2m]) > bool 0.5) default 0))",
     "legendFormat": "состояние",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "vm"
     }
    }
   ],
