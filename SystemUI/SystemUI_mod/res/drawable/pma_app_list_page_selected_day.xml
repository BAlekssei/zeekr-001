<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:height="6.0px" android:width="16.0px">
        <shape android:shape="rectangle">
            <solid android:color="#f88650" />
            <corners android:radius="10.0px" />
        </shape>
    </item>
    <item android:state_selected="false" android:height="6.0px" android:width="6.0px" android:left="6.0px" android:right="6.0px">
        <shape android:shape="oval">
            <solid android:color="#f7f8f9" />
        </shape>
    </item>
</selector>
